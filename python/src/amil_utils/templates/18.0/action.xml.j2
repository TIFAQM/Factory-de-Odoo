{# action.xml.j2 -- Odoo 18.0 window action for a model #}
<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_{{ model_name | to_xml_id }}" model="ir.actions.act_window">
        <field name="name">{{ model_label_plural | default(model_description) }}</field>
        <field name="res_model">{{ model_name }}</field>
        <field name="view_mode">{% if has_workflow_actions | default(false) %}kanban,list,form{% else %}list,form{% endif %}{% if has_dashboard %},graph,pivot{% endif %}</field>
        <field name="search_view_id" ref="view_{{ model_name | to_xml_id }}_search"/>
        <field name="context">{% if has_workflow_actions | default(false) and workflow_actions %}{'default_group_by': '{{ workflow_actions[0].state_field }}'}{% else %}{}{% endif %}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first {{ model_label | default(model_description) }}
            </p>
            <p>
                {{ (model_description | default("")) | replace('--', '—') }}
            </p>
        </field>
    </record>

</odoo>
